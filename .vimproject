    }
   }
   physicell_tools=physicell_tools {
   }
  }
  tasks=tasks{
   add_nodes.py
   analyze_connectivity.py
   analyze_gene_set.py
   apply_global_connection.py
   bridge_components.py
   complete_connection.py
   connect_targeted_nodes.py
   create_seed_network.py
   export_biomass_handoff.py
   export_neko_handoff.py
   export_network.py
   filter_interactions.py
   find_paths.py
   get_references.py
   hello_world.py
   list_genes_and_interactions.py
   network_status.py
   preview_connection_impact.py
   probe_exec_context.py
   probe_neko_import.py
   probe_path_return.py
   remove_bimodal_interactions.py
   remove_gene.py
   remove_interaction.py
   remove_undefined_interactions.py
  }
 }
 share=share{
  tasks=tasks{
  }
 }
 bin=bin filter="*"{
 }
